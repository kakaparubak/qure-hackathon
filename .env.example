# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Nothing here has a default in source. wiring.ts validates every variable at
# startup and throws a named error if one is missing, so a blank value fails
# loudly at boot instead of surfacing as `undefined` inside a fetch.

# --- Decision model (System One / OpenRouter) -------------------------------

# Base URL of the System One / OpenRouter endpoint. No trailing slash.
OPENROUTER_BASE_URL=

# Bearer token. Never commit the real value.
OPENROUTER_API_KEY=

# Model slugs, exactly as the provider lists them.
# CLAUDE.md names these as pplx-decider-v1.1 (primary) and jev-1.13 (fallback).
MODEL_PRIMARY_ID=pplx-decider-v1.1
MODEL_FALLBACK_ID=jev-1.13

# --- Triage thresholds ------------------------------------------------------

# P(red_flag) at or above this escalates. Per CLAUDE.md, and env-driven rather
# than hardcoded so they can be retuned during judging without a rebuild.
# The cutoff used depends on which model answered.
RED_FLAG_CUTOFF_PRIMARY=0.15
RED_FLAG_CUTOFF_FALLBACK=0.31

# --- WhatsApp channel (Baileys) ---------------------------------------------

# E.164 phone number the 8-digit pairing code is requested for, digits only,
# no leading '+'. This is the number that will be linked to the bot.
WA_PAIRING_NUMBER=

# --- Server -----------------------------------------------------------------

PORT=3000
