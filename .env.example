# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Nothing here has a default in source. wiring.ts validates every variable at
# startup and throws a named error if one is missing, so a blank value fails
# loudly at boot instead of surfacing as `undefined` inside a fetch.

# --- Decision model (System One / OpenRouter) -------------------------------

# FULL URL of the System One endpoint, path included. Not a base URL - the path
# is not guessed anywhere in code.
OPENROUTER_ENDPOINT=

# Bearer token. Never commit the real value.
OPENROUTER_API_KEY=
# Model slugs, exactly as the provider lists them. Slots are tried in order and
# the first one that answers wins.
MODEL_PRIMARY_ID=
MODEL_FALLBACK_ID=

# Third slot. Optional - leave both lines blank to run a two-model chain.
MODEL_TERTIARY_ID=
RED_FLAG_CUTOFF_TERTIARY=

# --- Triage thresholds ------------------------------------------------------

# P(red_flag) at or above this escalates TO A NURSE. These are NOT 0.5, and
# they are NOT portable between models: each was measured against its own score
# distribution. Using one model's cutoff on another's output silently changes
# who gets paged. Swapping a model means re-tuning its cutoff.
#
#   pplx-decider-v1.1-27b  0.15   cleanest separation on the 50-message corpus
#   typesafe/jev-1.13      0.31
#   cloudflare/clef-27b    0.11
#   clef-flash (9B)        -      rejected: an emergency scored inside the
#                                 negative distribution, so no cutoff exists
#
# Low on purpose: a missed emergency costs a life, a false alarm costs a nurse
# about twenty seconds.
RED_FLAG_CUTOFF_PRIMARY=
RED_FLAG_CUTOFF_FALLBACK=

# Highest urgency each slot may report (0-4). Defaults to 4 / 3 / 2 by position,
# so a smaller model further down the chain cannot claim emergency authority it
# has not earned. Override only with a reason.
# MODEL_PRIMARY_URGENCY_CEILING=4
# MODEL_FALLBACK_URGENCY_CEILING=3

# --- WhatsApp channel (Baileys) ---------------------------------------------

# Leave false to boot webhook-only: the pipeline is still fully driveable by
# curl at POST /webhook/inbound, with no phone linked. Set true to pair a
# number. This gate exists so a broken Baileys install cannot stop the API
# from booting on demo night.
WA_ENABLED=true

# E.164 phone number the 8-digit pairing code is requested for, digits only,
# no leading '+'. Required when WA_ENABLED=true.
WA_PAIRING_NUMBER=

# Where the pairing credentials are written. Gitignored - these files are a
# live session for the linked number.
WA_AUTH_DIR=.baileys

# --- Server -----------------------------------------------------------------

PORT=

DATABASE_URL=

# Estimated minutes per queue position, used only for the board's ETA column.
# Leave unset to show ETAs as unavailable - there is no guessed default.
# QUEUE_SERVICE_MINUTES=5
# Conversational intake extraction (separate from System One triage).
# Reuses OPENROUTER_API_KEY. Auto router is requested in the low cost tier.
# Override with a specific chat model slug if preferred.
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL_ID=openrouter/auto

# --- Intake LLM primary: your own z.ai GLM subscription (optional) -----------

# When set, the conversational intake runs on your GLM subscription first and
# falls back to the OpenRouter model above on any failure (quota, outage).
# Without it, OpenRouter handles everything.
ZAI_API_KEY=

# Standard API base. If your subscription is the CODING plan, use the
# /api/coding/paas/v4/ endpoint instead.
# ZAI_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
# ZAI_MODEL_ID=glm-5.3-flash

# Queue surge/callback settings. Surge starts at 3 active P1 visits.
# Routine ETAs include all priority patients ahead; unset service time keeps ETA unavailable.
# Callback timing is operational scheduling, configurable for the demo/service.
QUEUE_CALLBACK_DELAY_MINUTES=60
QUEUE_CALLBACK_SPACING_MINUTES=10

# Routine waiting-room check-ins: 30s poll, 45min inactivity interval, 3 attempts.
# Interval must be positive and <=1440; max reminders is an integer 1..10.
CHECK_IN_INTERVAL_MINUTES=45
CHECK_IN_MAX_REMINDERS=3

# Docker-only optional overrides (compose.yaml defaults shown).
# QURE_HOST_PORT=3000
# QURE_MEMORY_LIMIT=768m
# QURE_CPUS=1.0
# Optional direct/session connection used only by scripts/migrate.ts.
# MIGRATION_DATABASE_URL=postgresql://...
