{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "paths": {
      "@qure/core": ["./packages/core/src/index.ts"],
      "@qure/core/*": ["./packages/core/src/*.ts"]
    }
  }
}
