{
  "name": "qure-hackathon",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env --hot apps/api/src/index.ts",
    "build": "bun run --filter * build",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p packages/core && tsc --noEmit -p packages/db",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
