{
  "name": "qure-hackathon",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --hot apps/api/src/index.ts",
    "build": "bun run --cwd apps/dashboard build",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p packages/core && tsc --noEmit -p packages/db && tsc --noEmit -p apps/dashboard",
    "test": "bun test apps/api packages",
    "test:dashboard": "cd apps/dashboard && bun run test",
    "demo:fhir": "bun scripts/export-fhir-demo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  }
}
